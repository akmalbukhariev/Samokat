<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Ninimum.Components.ImagePreviewView"
    x:Name="ThisView"
    IsVisible="True"
    Opacity="1"
    InputTransparent="True"
    BackgroundColor="Transparent">

    <Grid BackgroundColor="Transparent" IsClippedToBounds="True">

        <!-- Telegram-style dimmed page background. -->
        <BoxView x:Name="boxFullImage"
                 BackgroundColor="Black"
                 IsVisible="False"
                 Opacity="0"
                 InputTransparent="True" />

        <!--
            Keep one full-screen gesture surface and transform only the image.
            Native Android/iOS gesture detectors are attached to this Grid in code.
            This avoids MAUI PinchGestureRecognizer + PanGestureRecognizer fighting
            over the same image, which was the cause of the shaking.
        -->
        <Grid x:Name="gestureSurface"
              BackgroundColor="Transparent">

            <Image x:Name="fullImage"
                   Source="{Binding Source={x:Reference ThisView}, Path=PreviewImageSource}"
                   Aspect="AspectFit"
                   IsVisible="False"
                   Opacity="1"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill"
                   AnchorX="0.5"
                   AnchorY="0.5" />
        </Grid>

    </Grid>
</ContentView>
