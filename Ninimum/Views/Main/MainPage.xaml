<page:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:page="clr-namespace:Ninimum.Views"
    xmlns:components="clr-namespace:Ninimum.Views.Main.Components"
    xmlns:main_components="clr-namespace:Ninimum.Components"
    xmlns:models="clr-namespace:Ninimum.Models.Main"
    xmlns:local="clr-namespace:Ninimum.Views.Main"
    x:Class="Ninimum.Views.Main.MainPage"
    BackgroundColor="White">

    <Grid RowDefinitions="Auto,*">

        <!-- FIXED HEADER -->
        <components:MainHeaderView Grid.Row="0"/>

        <!-- SCROLLABLE AREA -->
        <RefreshView
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}"
            Margin="10,5,10,5"
            Grid.Row="1">
            <CollectionView
                x:Name="MainCollectionView"
                ItemsSource="{Binding Products}"
                RemainingItemsThreshold="1"
                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                SelectionMode="None"
                Scrolled="MainCollectionView_Scrolled"
                Margin="10,10,10,0">

                <!-- HEADER INSIDE SCROLL -->
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="20">

                        <!-- THIS scrolls -->
                        <components:SearchBarView x:Name="InlineSearchBarView"/>

                        <components:OrderProcessView CurrentStep="OutForDelivery"/>

                        <components:AdBannerView
                            x:Name="AdBannerView"
                            ItemsSource="{Binding AdBanners}"
                            PurchaseCommand="{Binding PurchaseBannerCommand}" />

                    </VerticalStackLayout>
                </CollectionView.Header>

                <!-- PRODUCTS -->
                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        Orientation="Vertical"
                        VerticalItemSpacing="10"
                        HorizontalItemSpacing="10"
                        Span="2" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:MainProductCardItem">
                        <components:MainProductCardView
                                ImagesSource="{Binding Images}"
                                Price="{Binding Price}"
                                SubscriptionPrice="{Binding Subscription_price}"
                                Title="{Binding Title}"
                                Liked="{Binding Liked}"
                                Rating="{Binding Rating}"
                                ReviewCount="{Binding ReviewCount}"
                                IsCartLoading="{Binding IsCartLoading}"
                                LikeCommand="{Binding Source={RelativeSource AncestorType={x:Type local:MainPage}}, Path=BindingContext.LikeCommand}"
                                ClickProductCommand="{Binding Source={RelativeSource AncestorType={x:Type local:MainPage}}, Path=BindingContext.ClickProductCommand}"
                                ClickCartCommand="{Binding Source={RelativeSource AncestorType={x:Type local:MainPage}}, Path=BindingContext.ClickCartCommand}"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        
        <!-- STICKY SEARCH BAR -->
        <Grid
            x:Name="StickySearchBarContainer"
            Grid.Row="1"
            IsVisible="False"
            BackgroundColor="White"
            Padding="10"
            VerticalOptions="Start"
            ZIndex="10">

            <components:SearchBarView />
        </Grid>
        
        <main_components:CustomLikedView
            Grid.RowSpan="2"
            x:Name="likeView" 
            ShowLiked="{Binding IsLikedViewLiked}"
            IsVisible="{Binding ShowLikedView}"
            Grid.Row="2"/>
        
        <main_components:CustomCartView
            Grid.RowSpan="2"
            x:Name="cartView"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            ZIndex="20" />
        
        <main_components:LoadingView
            Grid.RowSpan="2"
            x:Name="loading"
            ShowLoading="{Binding IsLoading}"/>
    </Grid>
</page:BasePage>