<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Ninimum.Models.Main"
    x:Class="Ninimum.Views.Main.Components.AdBannerView"
    x:Name="RootView">

    <Grid RowDefinitions="Auto,Auto"
          RowSpacing="12">

        <!-- Banner carousel -->
        <CarouselView x:Name="BannerCarousel"
                      Grid.Row="0"
                      HeightRequest="200"
                      Loop="True"
                      PeekAreaInsets="0"
                      PositionChanged="OnCarouselPositionChanged">

            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="models:AdBannerItem">
                    <Grid Padding="2,0">
                        <Border
                            Padding="24,0,16,0"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 30"
                            HeightRequest="190"
                            VerticalOptions="Center">

                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,1">
                                    <GradientStop Color="#FF4747" Offset="0.0" />
                                    <GradientStop Color="#FF666F" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>

                            <Grid ColumnDefinitions="1.2*,0.8*"
                                  ColumnSpacing="10">

                                <!-- Left text + button -->
                                <VerticalStackLayout Grid.Column="0"
                                                     Spacing="16"
                                                     VerticalOptions="Center">

                                    <Label Text="{Binding Title}"
                                           TextColor="White"
                                           FontSize="21"
                                           FontFamily="{StaticResource FontSFBold}"
                                           LineBreakMode="WordWrap"
                                           MaxLines="3" />

                                    <Border StrokeThickness="0"
                                            BackgroundColor="#F2F2F2"
                                            StrokeShape="RoundRectangle 26"
                                            Padding="0"
                                            HorizontalOptions="Start">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnPurchaseTapped" />
                                        </Border.GestureRecognizers>
                                        <Grid Padding="14,6">
                                            <Label Text="Sotib olish"
                                                   TextColor="#252B33"
                                                   FontSize="17"
                                                   FontFamily="{StaticResource FontSFBold}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Keep banner product art inside a small intentional card.
                                     Product images commonly have a white source background;
                                     constraining it here prevents that background from covering
                                     the right half of the banner. -->
                                <Grid Grid.Column="1"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center">
                                    <Border WidthRequest="122"
                                            HeightRequest="150"
                                            Padding="7"
                                            BackgroundColor="#F8FFFFFF"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 18"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                        <Image Source="{Binding Image}"
                                               Aspect="AspectFit"
                                               HorizontalOptions="Fill"
                                               VerticalOptions="Fill" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- Custom indicator -->
        <Border Grid.Row="1"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                StrokeThickness="0"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 10,10,0,0"
                Padding="10,6,10,0"
                Margin="0,-35,0,0">

            <HorizontalStackLayout x:Name="CustomIndicatorLayout"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Spacing="10" />
        </Border>
    </Grid>
</ContentView>
