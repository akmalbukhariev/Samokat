<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Ninimum.Views.Main.Components.OrderProcessView"
    x:Name="ThisView">

    <ContentView.Resources>
        <ResourceDictionary>
            <Style x:Key="HeaderTitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{StaticResource FontSFBold}" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
            </Style>

            <Style x:Key="HeaderSubtitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="#D4DEE8" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="{StaticResource FontSFRegular}" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
            </Style>

            <Style x:Key="StepTextStyle" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="#C8D1DB" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="Start" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
                <Setter Property="FontFamily" Value="{StaticResource FontSFMedium}" />
            </Style>


            <Style x:Key="ConnectorDotStyle" TargetType="BoxView">
                <Setter Property="WidthRequest" Value="5" />
                <Setter Property="HeightRequest" Value="5" />
                <Setter Property="CornerRadius" Value="2.5" />
                <Setter Property="Color" Value="#33CC66" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
            <Style x:Key="StepIconStyle" TargetType="Image">
                <Setter Property="WidthRequest" Value="22" />
                <Setter Property="HeightRequest" Value="22" />
                <Setter Property="Aspect" Value="AspectFit" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid>
        <Border
            Padding="20,20"
            BackgroundColor="#314867"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 24">

            <VerticalStackLayout Spacing="18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleTapped" />
                    </Grid.GestureRecognizers>

                    <VerticalStackLayout Grid.Column="0" Spacing="6" HorizontalOptions="Fill">
                        <Label x:Name="TitleLabel" Style="{StaticResource HeaderTitleStyle}" />
                        <Label x:Name="SubtitleLabel" Style="{StaticResource HeaderSubtitleStyle}" />
                    </VerticalStackLayout>

                    <Image
                        x:Name="ToggleImage"
                        Grid.Column="1"
                        WidthRequest="15"
                        HeightRequest="15"
                        Source="ic_arrow_up.png"
                        IsVisible="{Binding Source={x:Reference ThisView}, Path=InternalToggleEnabled}"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,8,0,0" />
                </Grid>

                <Grid
                    x:Name="ProgressContainer"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="14">

                    <Grid
                        Grid.Row="0"
                        ColumnDefinitions="34,*,34,*,34,*,34,*,34"
                        ColumnSpacing="0"
                        VerticalOptions="Center"
                        HeightRequest="42">

                        <Grid Grid.Column="1" Margin="1,0">
                            <BoxView x:Name="Connector1Solid" HeightRequest="6" CornerRadius="3" Color="#33CC66" HorizontalOptions="Fill" VerticalOptions="Center" IsVisible="False" />
                            <Grid x:Name="Connector1Dots" ColumnDefinitions="*,*,*,*,*">
                                <BoxView Grid.Column="0" Style="{StaticResource ConnectorDotStyle}" />
                                <BoxView Grid.Column="1" Style="{StaticResource ConnectorDotStyle}" />
                                <BoxView Grid.Column="2" Style="{StaticResource ConnectorDotStyle}" />
                                <BoxView Grid.Column="3" Style="{StaticResource ConnectorDotStyle}" />
                                <BoxView Grid.Column="4" Style="{StaticResource ConnectorDotStyle}" />
                            </Grid>
                        </Grid>

                        <Grid Grid.Column="3" Margin="1,0">
                            <BoxView x:Name="Connector2Solid" HeightRequest="6" CornerRadius="3" Color="#33CC66" HorizontalOptions="Fill" VerticalOptions="Center" IsVisible="False" />
                            <Grid x:Name="Connector2Dots" ColumnDefinitions="*,*,*,*,*">
                                <BoxView Grid.Column="0" Style="{StaticResource ConnectorDotStyle}" />
                                <BoxView Grid.Column="1" Style="{StaticResource ConnectorDotStyle}" />
                                <BoxView Grid.Column="2" Style="{StaticResource ConnectorDotStyle}" />
                                <BoxView Grid.Column="3" Style="{StaticResource ConnectorDotStyle}" />
                                <BoxView Grid.Column="4" Style="{StaticResource ConnectorDotStyle}" />
                            </Grid>
                        </Grid>

                        <Grid Grid.Column="5" Margin="1,0">
                            <BoxView x:Name="Connector3Solid" HeightRequest="6" CornerRadius="3" Color="#33CC66" HorizontalOptions="Fill" VerticalOptions="Center" IsVisible="False" />
                            <Grid x:Name="Connector3Dots" ColumnDefinitions="*,*,*,*,*">
                                <BoxView Grid.Column="0" Style="{StaticResource ConnectorDotStyle}" />
                                <BoxView Grid.Column="1" Style="{StaticResource ConnectorDotStyle}" />
                                <BoxView Grid.Column="2" Style="{StaticResource ConnectorDotStyle}" />
                                <BoxView Grid.Column="3" Style="{StaticResource ConnectorDotStyle}" />
                                <BoxView Grid.Column="4" Style="{StaticResource ConnectorDotStyle}" />
                            </Grid>
                        </Grid>

                        <Grid Grid.Column="7" Margin="1,0">
                            <BoxView x:Name="Connector4Solid" HeightRequest="6" CornerRadius="3" Color="#33CC66" HorizontalOptions="Fill" VerticalOptions="Center" IsVisible="False" />
                            <Grid x:Name="Connector4Dots" ColumnDefinitions="*,*,*,*,*">
                                <BoxView Grid.Column="0" Style="{StaticResource ConnectorDotStyle}" />
                                <BoxView Grid.Column="1" Style="{StaticResource ConnectorDotStyle}" />
                                <BoxView Grid.Column="2" Style="{StaticResource ConnectorDotStyle}" />
                                <BoxView Grid.Column="3" Style="{StaticResource ConnectorDotStyle}" />
                                <BoxView Grid.Column="4" Style="{StaticResource ConnectorDotStyle}" />
                            </Grid>
                        </Grid>

                        <Border x:Name="Step1Node" Grid.Column="0" WidthRequest="34" HeightRequest="34" BackgroundColor="#33CC66" StrokeThickness="0" StrokeShape="RoundRectangle 10" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image x:Name="Step1Icon" Style="{StaticResource StepIconStyle}" Source="order_step_payment_active.png" />
                        </Border>

                        <Border x:Name="Step2Node" Grid.Column="2" WidthRequest="34" HeightRequest="34" BackgroundColor="White" Stroke="#D5DBE3" StrokeThickness="1" StrokeShape="RoundRectangle 10" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image x:Name="Step2Icon" Style="{StaticResource StepIconStyle}" Source="order_step_product_inactive.png" />
                        </Border>

                        <Border x:Name="Step3Node" Grid.Column="4" WidthRequest="34" HeightRequest="34" BackgroundColor="White" Stroke="#D5DBE3" StrokeThickness="1" StrokeShape="RoundRectangle 10" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image x:Name="Step3Icon" Style="{StaticResource StepIconStyle}" Source="order_step_ready_inactive.png" />
                        </Border>

                        <Border x:Name="Step4Node" Grid.Column="6" WidthRequest="34" HeightRequest="34" BackgroundColor="White" Stroke="#D5DBE3" StrokeThickness="1" StrokeShape="RoundRectangle 10" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image x:Name="Step4Icon" Style="{StaticResource StepIconStyle}" Source="order_step_delivery_inactive.png" />
                        </Border>

                        <Border x:Name="Step5Node" Grid.Column="8" WidthRequest="34" HeightRequest="34" BackgroundColor="White" Stroke="#D5DBE3" StrokeThickness="1" StrokeShape="RoundRectangle 10" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image x:Name="Step5Icon" Style="{StaticResource StepIconStyle}" Source="order_step_delivered_inactive.png" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                        <Label x:Name="Step1Label" Grid.Column="0" Style="{StaticResource StepTextStyle}" Text="To'lov&#10;qilindi" />
                        <Label x:Name="Step2Label" Grid.Column="1" Style="{StaticResource StepTextStyle}" Text="Mahsulot&#10;tayyorlanmoqda" />
                        <Label x:Name="Step3Label" Grid.Column="2" Style="{StaticResource StepTextStyle}" Text="Yetkazishga&#10;tayyor" />
                        <Label x:Name="Step4Label" Grid.Column="3" Style="{StaticResource StepTextStyle}" Text="Yetkazil&#10;moqda" />
                        <Label x:Name="Step5Label" Grid.Column="4" Style="{StaticResource StepTextStyle}" Text="Yetkazildi" />
                    </Grid>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Grid
            IsVisible="{Binding Source={x:Reference ThisView}, Path=IsLoading}"
            BackgroundColor="#CC314867">

            <Border
                Padding="22,16"
                Margin="25"
                BackgroundColor="White"
                Stroke="#EEEEEE"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <HorizontalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                    <ActivityIndicator
                        WidthRequest="25"
                        HeightRequest="25"
                        Color="#FD473C"
                        IsRunning="{Binding Source={x:Reference ThisView}, Path=IsLoading}"
                        VerticalOptions="Center" />

                    <Label
                        Text="Buyurtma holati yuklanmoqda..."
                        TextColor="#22292F"
                        FontSize="14"
                        VerticalOptions="Center"
                        FontFamily="{StaticResource FontSFMedium}" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>
