<?xml version="1.0" encoding="utf-8" ?>

<page:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:language="clr-namespace:Ninimum.Resources.Languages"
    xmlns:page="clr-namespace:Ninimum.Views"
    xmlns:components="clr-namespace:Ninimum.Components"
    x:Class="Ninimum.Views.Payment.PaymentPage"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="White">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <components:PageHeaderView
            Grid.Row="0"
            ShowBack="true"
            Title="{x:Static language:AppResource.Payment}"
            BackCommand="{Binding BackCommand}"
            NavigateBackAutomatically="False" />

        <!-- Payment content -->
        <Grid Grid.Row="1">

            <WebView
                x:Name="PaymeWebView"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                Navigating="PaymeWebView_Navigating"
                Navigated="PaymeWebView_Navigated" />

            <!-- Shown when the customer is back from Payme and nothing is confirmed yet -->
            <Border
                x:Name="PendingHint"
                IsVisible="False"
                VerticalOptions="End"
                Margin="12"
                Padding="14,12"
                BackgroundColor="#FFF4E5"
                Stroke="#F5C27A"
                StrokeShape="RoundRectangle 12">
                <Label
                    x:Name="PendingHintLabel"
                    TextColor="#5C3B00"
                    FontSize="14"
                    LineBreakMode="WordWrap"
                    FontFamily="{StaticResource FontSFRegular}" />
            </Border>

            <!-- Loading overlay -->
            <Grid
                x:Name="LoadingLayout"
                BackgroundColor="#80FFFFFF"
                IsVisible="True">

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="14">

                    <ActivityIndicator
                        x:Name="ActivityIndicator"
                        IsRunning="True"
                        WidthRequest="44"
                        HeightRequest="44"
                        Color="#FD473C" />

                    <Label
                        Text="{x:Static language:AppResource.LoadingPaymentPage}"
                        TextColor="#22292F"
                        FontSize="16"
                        HorizontalTextAlignment="Center"
                        FontFamily="{StaticResource FontSFRegular}" />

                </VerticalStackLayout>

            </Grid>

        </Grid>

    </Grid>

</page:BasePage>
