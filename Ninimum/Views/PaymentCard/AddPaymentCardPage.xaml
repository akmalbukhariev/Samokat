<?xml version="1.0" encoding="utf-8" ?>
<page:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:page="clr-namespace:Ninimum.Views"
    xmlns:components="clr-namespace:Ninimum.Components"
    xmlns:converter="clr-namespace:Ninimum.Converter"
    x:Class="Ninimum.Views.PaymentCard.AddPaymentCardPage"
    x:Name="ThisPage"
    BackgroundColor="White">

    <page:BasePage.Resources>
        <ResourceDictionary>
            <converter:BoolToImageConverter x:Key="BoolToImageConverter"/>
        </ResourceDictionary>
    </page:BasePage.Resources>

    <Grid RowDefinitions="Auto,24,*,Auto">

        <components:PageHeaderView Title="Yangi karta qo’shish" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,0,16,20" Spacing="24">

                <Border
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    HeightRequest="264">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                            <GradientStop Color="#32D994" Offset="0.0" />
                            <GradientStop Color="#107096" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <VerticalStackLayout
                        Padding="20"
                        VerticalOptions="Center"
                        Spacing="24">

                        <VerticalStackLayout Spacing="4">
                            <Label
                                Text="Karta raqami"
                                FontFamily="{StaticResource FontSFRegular}"
                                FontSize="15"
                                TextColor="White" />

                            <Entry
                                x:Name="CardNumberEntry"
                                Text="{Binding CardNumber}"
                                BackgroundColor="Transparent"
                                TextColor="White"
                                FontFamily="{StaticResource FontSFMedium}"
                                FontSize="24"
                                Keyboard="Numeric"
                                MaxLength="19"
                                Placeholder="8600 1204 2881 8500"
                                PlaceholderColor="#CCFFFFFF"
                                IsReadOnly="False"
                                IsEnabled="True" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout
                            HorizontalOptions="Center"
                            Spacing="24">

                            <Border
                                WidthRequest="220"
                                Padding="16,10"
                                BackgroundColor="#33FFFFFF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10">

                                <VerticalStackLayout Spacing="4">
                                    <Label
                                        Text="Amal qilishi"
                                        FontFamily="{StaticResource FontSFRegular}"
                                        FontSize="15"
                                        TextColor="White" />

                                    <HorizontalStackLayout
                                        Spacing="4"
                                        HorizontalOptions="Center">

                                        <Entry
                                            x:Name="MonthEntry"
                                            Text="{Binding ExpireMonth}"
                                            WidthRequest="36"
                                            MaxLength="2"
                                            Keyboard="Numeric"
                                            BackgroundColor="Transparent"
                                            TextColor="White"
                                            FontFamily="{StaticResource FontSFMedium}"
                                            FontSize="24"
                                            HorizontalTextAlignment="Center"
                                            Placeholder="01"
                                            PlaceholderColor="#CCFFFFFF" />

                                        <Label
                                            Text="/"
                                            TextColor="White"
                                            FontFamily="{StaticResource FontSFMedium}"
                                            FontSize="24"
                                            VerticalTextAlignment="Center" />

                                        <Entry
                                            x:Name="YearEntry"
                                            Text="{Binding ExpireYear}"
                                            WidthRequest="36"
                                            MaxLength="2"
                                            Keyboard="Numeric"
                                            BackgroundColor="Transparent"
                                            TextColor="White"
                                            FontFamily="{StaticResource FontSFMedium}"
                                            FontSize="24"
                                            HorizontalTextAlignment="Center"
                                            Placeholder="28"
                                            PlaceholderColor="#CCFFFFFF" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- CVV hidden for MVP -->
                            <Border
                                IsVisible="False"
                                WidthRequest="110"
                                Padding="16,10"
                                BackgroundColor="#33FFFFFF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10">

                                <VerticalStackLayout Spacing="4">
                                    <Label
                                        Text="CVV"
                                        FontFamily="{StaticResource FontSFRegular}"
                                        FontSize="15"
                                        TextColor="White" />

                                    <Entry
                                        Text="{Binding Cvv}"
                                        BackgroundColor="Transparent"
                                        TextColor="White"
                                        FontFamily="{StaticResource FontSFMedium}"
                                        FontSize="24"
                                        Keyboard="Numeric"
                                        MaxLength="3"
                                        IsPassword="True"
                                        Placeholder="***"
                                        PlaceholderColor="#CCFFFFFF" />
                                </VerticalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Grid 
                    ColumnDefinitions="*,Auto" 
                    ColumnSpacing="16" 
                    IsVisible="False">
                    <VerticalStackLayout Spacing="2">
                        <Label
                            Text="Kartani saqlash"
                            FontFamily="{StaticResource FontSFRegular}"
                            FontSize="17"
                            TextColor="#22292F" />

                        <Label
                            Text="Keyingi xaridlar uchun ushbu kartani saqlashga roziman"
                            FontFamily="{StaticResource FontSFRegular}"
                            FontSize="13"
                            TextColor="#96979B" />
                    </VerticalStackLayout>

                    <Image
                        Grid.Column="1"
                        Source="{Binding RememberCard, Converter={StaticResource BoolToImageConverter}}"
                        WidthRequest="40"
                        HeightRequest="24"
                        VerticalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleRememberCommand}" />
                        </Image.GestureRecognizers>
                    </Image>
                </Grid>

                <Border
                    BackgroundColor="#F1FAEA"
                    Stroke="#D8EFC9"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="14">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Image
                            Source="ic_security.png"
                            WidthRequest="34"
                            HeightRequest="34"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="1"
                            Text="Karta ma’lumotlari xavfsiz saqlanadi va uchinchi shaxslarga berilmaydi."
                            FontFamily="{StaticResource FontSFRegular}"
                            FontSize="15"
                            TextColor="#22292F"
                            LineBreakMode="WordWrap"
                            VerticalTextAlignment="Center" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Border
            Grid.Row="3"
            Margin="16,0,16,20"
            BackgroundColor="#7CB518"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 40"
            HeightRequest="56">

            <Border.GestureRecognizers>
                <TapGestureRecognizer 
                    NumberOfTapsRequired="1" 
                    Tapped="SaveCard_Tapped"/>
            </Border.GestureRecognizers>

            <Grid>
                <Label
                    Text="Saqlash"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    FontFamily="{StaticResource FontSFMedium}"
                    FontSize="18"
                    TextColor="White" />
            </Grid>
        </Border>

    </Grid>
</page:BasePage>