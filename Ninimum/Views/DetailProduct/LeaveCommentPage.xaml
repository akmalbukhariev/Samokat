<?xml version="1.0" encoding="utf-8" ?>
<page:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:page="clr-namespace:Ninimum.Views"
    xmlns:components="clr-namespace:Ninimum.Components"
    xmlns:main_components="clr-namespace:Ninimum.Views.Main.Components"
    xmlns:models="clr-namespace:Ninimum.Models.Main"
    xmlns:local="clr-namespace:Ninimum.Views.DetailProduct"
    x:Class="Ninimum.Views.DetailProduct.LeaveCommentPage"
    x:Name="ThisPage"
    BackgroundColor="White">

    <Grid RowDefinitions="Auto,24,*">

        <components:PageHeaderView
            Title="{Binding PageTitle}"
            Grid.Row="0" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="20,0,20,30" Spacing="20">
                    
                <!-- Product info -->
                <Frame
                    Padding="14,12"
                    CornerRadius="10"
                    HasShadow="False"
                    BackgroundColor="#FBEFF1"
                    BorderColor="Transparent">
                    <Label
                        Text="{Binding ProductTitle}"
                        FontSize="18"
                        FontFamily="{StaticResource FontSFMedium}"
                        LineBreakMode="WordWrap"
                        TextColor="#333333" />
                </Frame>

                <!-- Rating title -->
                <Label
                    Text="Yulduzchalar orqali baho qo’ying"
                    FontSize="22"
                    FontFamily="{StaticResource FontSFMedium}"
                    TextColor="#222222" />

                <!-- Rating stars -->
                <HorizontalStackLayout Spacing="8">
                    <Image x:Name="Star1" WidthRequest="32" HeightRequest="32" Source="star_gray.png">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStar1Tapped"/>
                        </Image.GestureRecognizers>
                    </Image>

                    <Image x:Name="Star2" WidthRequest="32" HeightRequest="32" Source="star_gray.png">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStar2Tapped"/>
                        </Image.GestureRecognizers>
                    </Image>

                    <Image x:Name="Star3" WidthRequest="32" HeightRequest="32" Source="star_gray.png">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStar3Tapped"/>
                        </Image.GestureRecognizers>
                    </Image>

                    <Image x:Name="Star4" WidthRequest="32" HeightRequest="32" Source="star_gray.png">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStar4Tapped"/>
                        </Image.GestureRecognizers>
                    </Image>

                    <Image x:Name="Star5" WidthRequest="32" HeightRequest="32" Source="star_gray.png">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStar5Tapped"/>
                        </Image.GestureRecognizers>
                    </Image>

                </HorizontalStackLayout>

                <!-- Comment title -->
                <Label
                    Text="Mahsulot bo’yicha fikringizni yozing"
                    FontSize="22"
                    FontFamily="{StaticResource FontSFMedium}"
                    TextColor="#222222" />

                <!-- Comment editor -->
                <Frame
                    Padding="0"
                    CornerRadius="10"
                    HasShadow="False"
                    BackgroundColor="#F5F6F8"
                    BorderColor="Transparent">
                    <Editor
                        x:Name="CommentEditor"
                        HeightRequest="130"
                        BackgroundColor="Transparent"
                        Placeholder="Sharh yozing"
                        FontFamily="{StaticResource FontSFRegular}"
                        FontSize="15"
                        TextColor="#333333"
                        Margin="12,10" />
                </Frame>

                <!-- Photo title -->
                <Label
                    Text="Mahsulot bo’yicha fotosurat joylang"
                    FontSize="22"
                    FontFamily="{StaticResource FontSFMedium}"
                    TextColor="#222222" />

                <!-- Photo upload area -->
                <Frame
                    Padding="12"
                    CornerRadius="10"
                    HasShadow="False"
                    BorderColor="#D9D9D9"
                    BackgroundColor="White">

                    <VerticalStackLayout Spacing="12">
                        <CollectionView
                            IsVisible="{Binding HasSelectedImages}"
                            ItemsSource="{Binding SelectedImages}"
                            ItemsLayout="HorizontalList"
                            SelectionMode="None"
                            HeightRequest="84">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid WidthRequest="84" HeightRequest="84" Margin="0,0,8,0">
                                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                            <Image Source="{Binding PreviewSource}" Aspect="AspectFill" />
                                        </Border>
                                        <Border
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            Margin="0,4,4,0"
                                            Padding="5,1"
                                            BackgroundColor="#99000000"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10">
                                            <Label Text="×" TextColor="White" FontSize="16" />
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnRemovePhotoTapped" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border
                                Grid.Column="0"
                                HeightRequest="52"
                                Stroke="#D9D9D9"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="#F8F8F8"
                                IsEnabled="{Binding CanAddMorePhotos}">
                                <HorizontalStackLayout
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    Spacing="7">
                                    <Label Text="+" FontSize="24" TextColor="#7CB518" VerticalTextAlignment="Center" />
                                    <Label Text="Kamera" FontSize="14" TextColor="#555555" VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTakePhotoTapped" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Border
                                Grid.Column="1"
                                HeightRequest="52"
                                Stroke="#D9D9D9"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="#F8F8F8"
                                IsEnabled="{Binding CanAddMorePhotos}">
                                <HorizontalStackLayout
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    Spacing="7">
                                    <Label Text="+" FontSize="24" TextColor="#7CB518" VerticalTextAlignment="Center" />
                                    <Label Text="Galereya" FontSize="14" TextColor="#555555" VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPickPhotoTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>

                        <Label
                            Text="{Binding PhotoLimitText}"
                            FontSize="12"
                            TextColor="#999999"
                            HorizontalTextAlignment="End" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Submit button -->
                <Button
                    x:Name="SubmitButton"
                    Text="{Binding DefaultSubmitButtonText}"
                    HeightRequest="58"
                    CornerRadius="12"
                    BackgroundColor="#84BC13"
                    TextColor="White"
                    FontSize="20"
                    FontFamily="{StaticResource FontSFMedium}"
                    Margin="0,20,0,0"
                    Clicked="OnSubmitClicked" />

            </VerticalStackLayout>
        </ScrollView>

        <components:LoadingView
            Grid.RowSpan="3"
            ZIndex="1000"
            ShowLoading="{Binding IsLoading}" />
    </Grid>
</page:BasePage>