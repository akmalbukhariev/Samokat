<?xml version="1.0" encoding="utf-8" ?>
<page:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:page="clr-namespace:Ninimum.Views"
    xmlns:components="clr-namespace:Ninimum.Components"
    x:Class="Ninimum.Views.DetailProduct.ProductQuestionsPage">

    <Grid RowDefinitions="Auto,*,Auto">
        <components:PageHeaderView
            Title="Mahsulot savollari"
            ShowRightIcon="False"
            BackCommand="{Binding BackCommand}" />

        <RefreshView
            Grid.Row="1"
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}">

            <CollectionView
                ItemsSource="{Binding Questions}"
                SelectionMode="None"
                BackgroundColor="White">

                <CollectionView.Header>
                    <VerticalStackLayout Padding="16,12,16,18" Spacing="14">
                        <Border
                            Padding="12"
                            BackgroundColor="#FFF2F3"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8">
                            <Label
                                Text="{Binding Title}"
                                TextColor="#22292F"
                                FontSize="18"
                                FontFamily="{StaticResource FontSFMedium}"
                                LineBreakMode="WordWrap" />
                        </Border>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="Savol va javoblar"
                                TextColor="#22292F"
                                FontSize="19"
                                FontFamily="{StaticResource FontSFMedium}" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding QuestionCountText}"
                                TextColor="#96979B"
                                FontSize="15"
                                FontFamily="{StaticResource FontSFRegular}"
                                VerticalTextAlignment="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="24,70,24,40"
                        Spacing="8"
                        HorizontalOptions="Center">
                        <Label
                            Text="Hali savollar yo'q"
                            TextColor="#22292F"
                            FontSize="20"
                            FontFamily="{StaticResource FontSFMedium}"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Text="Ushbu mahsulot bo'yicha birinchi savolni siz berishingiz mumkin."
                            TextColor="#96979B"
                            FontSize="16"
                            FontFamily="{StaticResource FontSFRegular}"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Padding="16,0,16,18" Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    Text="{Binding CustomerName}"
                                    TextColor="#22292F"
                                    FontSize="17"
                                    FontFamily="{StaticResource FontSFMedium}" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding CreatedDate}"
                                    TextColor="#96979B"
                                    FontSize="15"
                                    FontFamily="{StaticResource FontSFRegular}" />
                            </Grid>

                            <Grid ColumnDefinitions="32,*" ColumnSpacing="10">
                                <Border
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    Padding="0"
                                    StrokeThickness="0"
                                    BackgroundColor="#7CB518"
                                    StrokeShape="RoundRectangle 15">
                                    <Label
                                        Text="S"
                                        TextColor="White"
                                        FontSize="15"
                                        FontFamily="{StaticResource FontSFBold}"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center" />
                                </Border>
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Question}"
                                    TextColor="#22292F"
                                    FontSize="17"
                                    FontFamily="{StaticResource FontSFRegular}"
                                    LineBreakMode="WordWrap"
                                    VerticalTextAlignment="Center" />
                            </Grid>

                            <Border
                                IsVisible="{Binding IsAnswered}"
                                Margin="0,2,0,0"
                                Padding="12"
                                StrokeThickness="0"
                                BackgroundColor="#F8FCF0"
                                StrokeShape="RoundRectangle 8">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label
                                            Text="Ninimum javobi"
                                            TextColor="#7CB518"
                                            FontSize="15"
                                            FontFamily="{StaticResource FontSFBold}" />
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding AnsweredDate}"
                                            TextColor="#96979B"
                                            FontSize="14"
                                            FontFamily="{StaticResource FontSFRegular}" />
                                    </Grid>
                                    <Label
                                        Text="{Binding Answer}"
                                        TextColor="#22292F"
                                        FontSize="16"
                                        FontFamily="{StaticResource FontSFRegular}"
                                        LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>

                            <Label
                                IsVisible="{Binding IsWaiting}"
                                Text="Javob kutilmoqda"
                                TextColor="#96979B"
                                FontSize="15"
                                FontFamily="{StaticResource FontSFRegular}"
                                Margin="42,0,0,0" />

                            <BoxView HeightRequest="1" BackgroundColor="#F0F0F0" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Border
            Grid.Row="2"
            Margin="16,8,16,14"
            Padding="14"
            StrokeThickness="0"
            BackgroundColor="#F7F8FB"
            StrokeShape="RoundRectangle 10">
            <VerticalStackLayout Spacing="10">
                <Label
                    Text="Mahsulot haqida savolingiz bormi?"
                    TextColor="#4F535A"
                    FontSize="15"
                    FontFamily="{StaticResource FontSFRegular}" />
                <Button
                    Text="Savol berish"
                    Command="{Binding AskQuestionCommand}"
                    HeightRequest="52"
                    CornerRadius="8"
                    BackgroundColor="#7CB518"
                    TextColor="White"
                    FontSize="18"
                    FontFamily="{StaticResource FontSFMedium}" />
            </VerticalStackLayout>
        </Border>

        <components:LoadingView
            Grid.RowSpan="3"
            ZIndex="100"
            ShowLoading="{Binding IsLoading}" />
    </Grid>
</page:BasePage>
