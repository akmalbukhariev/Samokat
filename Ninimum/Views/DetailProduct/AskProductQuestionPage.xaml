<?xml version="1.0" encoding="utf-8" ?>
<page:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:language="clr-namespace:Ninimum.Resources.Languages"
    xmlns:page="clr-namespace:Ninimum.Views"
    xmlns:components="clr-namespace:Ninimum.Components"
    x:Class="Ninimum.Views.DetailProduct.AskProductQuestionPage"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">
        <components:PageHeaderView
            Title="{x:Static language:AppResource.AskAQuestion}"
            ShowRightIcon="False"
            BackCommand="{Binding BackCommand}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,12,16,24" Spacing="20">
                <Border
                    Padding="12"
                    BackgroundColor="#FFF2F3"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8">
                    <Label
                        Text="{Binding Title}"
                        TextColor="#22292F"
                        FontSize="18"
                        FontFamily="{StaticResource FontSFMedium}"
                        LineBreakMode="WordWrap" />
                </Border>

                <VerticalStackLayout Spacing="7">
                    <Label
                        Text="{x:Static language:AppResource.WriteYourQuestionAboutTheProduct}"
                        TextColor="#22292F"
                        FontSize="20"
                        FontFamily="{StaticResource FontSFMedium}"
                        LineBreakMode="WordWrap" />
                    <Label
                        Text="{x:Static language:AppResource.YouCanAskASpecificQuestionAboutThe}"
                        TextColor="#96979B"
                        FontSize="15"
                        FontFamily="{StaticResource FontSFRegular}"
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <Border
                    Padding="14"
                    BackgroundColor="#F7F8FB"
                    Stroke="#ECEDEF"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10">
                    <Editor
                        Text="{Binding QuestionText}"
                        Placeholder="{x:Static language:AppResource.EnterYourQuestion}"
                        PlaceholderColor="#A3A5AA"
                        TextColor="#22292F"
                        FontSize="17"
                        FontFamily="{StaticResource FontSFRegular}"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="180"
                        MaxLength="1000"
                        BackgroundColor="Transparent" />
                </Border>

                <Label
                    Text="{Binding CharacterCountText}"
                    TextColor="#96979B"
                    FontSize="14"
                    FontFamily="{StaticResource FontSFRegular}"
                    HorizontalTextAlignment="End" />

                <Border
                    Padding="12"
                    BackgroundColor="#F8FCF0"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8">
                    <Label
                        Text="{x:Static language:AppResource.YouDoNotNeedToHavePurchasedThe}"
                        TextColor="#6C951C"
                        FontSize="14"
                        FontFamily="{StaticResource FontSFRegular}"
                        LineBreakMode="WordWrap" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Button
            Grid.Row="2"
            Margin="16,10,16,18"
            Text="{x:Static language:AppResource.SendQuestion}"
            Command="{Binding SubmitCommand}"
            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
            HeightRequest="56"
            CornerRadius="8"
            BackgroundColor="#7CB518"
            TextColor="White"
            FontSize="18"
            FontFamily="{StaticResource FontSFMedium}" />

        <components:LoadingView
            Grid.RowSpan="3"
            ZIndex="100"
            ShowLoading="{Binding IsLoading}" />
    </Grid>
</page:BasePage>
