<?xml version="1.0" encoding="utf-8" ?>
<page:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:page="clr-namespace:Ninimum.Views"
    xmlns:components="clr-namespace:Ninimum.Components"
    xmlns:main_components="clr-namespace:Ninimum.Views.Main.Components"
    xmlns:models="clr-namespace:Ninimum.Models.Main"
    xmlns:local="clr-namespace:Ninimum.Views.DetailProduct"
    x:Class="Ninimum.Views.DetailProduct.ProductReviews"
    x:Name="ThisPage">

    <Grid>
        <Grid 
            RowDefinitions="Auto, 24,*,Auto, Auto" 
            RowSpacing="0">

            <!-- Header -->
            <components:PageHeaderView
                Title="Maxsulot Sharhlari"
                ShowRightIcon="false"
                RightImage="ic_filter1.png"
                BackCommand="{Binding BackCommand}"
                RightImageCommand="{Binding FilterTapCommand}" />

            <!-- Main scrollable content -->
            <RefreshView
                Grid.Row="2"
                IsRefreshing="{Binding IsRefreshing}"
                Command="{Binding RefreshCommand}">
            <CollectionView
                ItemsSource="{Binding Reviews}"
                SelectionMode="None"
                BackgroundColor="White"
                Margin="0">

                <CollectionView.Header>
                    <VerticalStackLayout
                        Padding="16,12,16,16"
                        Spacing="16">

                        <!-- Buyer photos header -->
                        <Grid 
                            IsVisible="False"
                            ColumnDefinitions="*,Auto">
                            <Label
                                Text="Xaridorlarning fotosuratlari"
                                TextColor="#22292F"
                                FontSize="18"
                                FontFamily="{StaticResource FontSFMedium}"
                                CharacterSpacing="0.18"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding BuyerPhotosCountText}"
                                TextColor="#7CB518"
                                FontSize="16"
                                FontFamily="{StaticResource FontSFBold}"
                                CharacterSpacing="0.16"
                                VerticalOptions="Center" />
                        </Grid>

                        <!-- Buyer photos horizontal list -->
                        <CollectionView
                            IsVisible="False"
                            ItemsSource="{Binding BuyerPhotos}"
                            ItemsLayout="HorizontalList"
                            SelectionMode="None"
                            HeightRequest="120"
                            Margin="0">

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,10,0"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        WidthRequest="90"
                                        HeightRequest="120">
                                        <Image
                                            Source="{Binding}"
                                            Aspect="AspectFill"
                                            WidthRequest="90"
                                            HeightRequest="120">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type local:ProductReviews}}, Path=BindingContext.PreviewImageCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Product title card -->
                        <Border
                            Padding="10"
                            BackgroundColor="#FFF2F3"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8">
                            <Label
                                Text="{Binding Title}"
                                TextColor="#22292F"
                                FontSize="18"
                                FontFamily="{StaticResource FontSFMedium}"
                                CharacterSpacing="0.18"
                                LineBreakMode="WordWrap" />
                        </Border>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout
                            Padding="16,0,16,18"
                            Spacing="8">

                            <!-- Review main block -->
                            <VerticalStackLayout Spacing="14">

                                <VerticalStackLayout Spacing="5">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label
                                            Text="{Binding CustomerName}"
                                            TextColor="#22292F"
                                            FontSize="18"
                                            FontFamily="{StaticResource FontSFMedium}"
                                            CharacterSpacing="0.18" />

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding ReviewDate}"
                                            TextColor="#96979B"
                                            FontSize="17"
                                            FontFamily="{StaticResource FontSFRegular}"
                                            CharacterSpacing="0.17" />
                                    </Grid>

                                    <!-- Stars -->
                                    <HorizontalStackLayout Spacing="10">
                                        <Label
                                            Text="{Binding StarsText}"
                                            TextColor="#F78A08"
                                            FontSize="18"
                                            LineBreakMode="NoWrap" />
                                        <Label
                                            Text="Tasdiqlangan xarid"
                                            TextColor="#7CB518"
                                            FontSize="13"
                                            FontFamily="{StaticResource FontSFMedium}"
                                            VerticalTextAlignment="Center"
                                            IsVisible="{Binding IsVerifiedPurchase}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Review text -->
                                <Label
                                    Text="{Binding ReviewText}"
                                    TextColor="#22292F"
                                    FontSize="17"
                                    FontFamily="{StaticResource FontSFRegular}"
                                    CharacterSpacing="0.17"
                                    LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <!-- Review photos -->
                            <CollectionView
                                ItemsSource="{Binding Photos}"
                                ItemsLayout="HorizontalList"
                                SelectionMode="None"
                                HeightRequest="120"
                                IsVisible="{Binding HasPhotos}">

                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,8,0"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            WidthRequest="90"
                                            HeightRequest="120">
                                            <Image
                                                Source="{Binding}"
                                                Aspect="AspectFill"
                                                WidthRequest="90"
                                                HeightRequest="120">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:ProductReviews}}, Path=BindingContext.PreviewImageCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Image.GestureRecognizers>
                                            </Image>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <!-- Admin reply -->
                            <Border
                                Padding="10"
                                BackgroundColor="#F7F9FB"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                IsVisible="{Binding HasReply}">
                                <Label
                                    Text="{Binding ReplyText}"
                                    TextColor="#7CB518"
                                    FontSize="17"
                                    FontFamily="{StaticResource FontSFRegular}"
                                    CharacterSpacing="0.17"
                                    LineBreakMode="WordWrap" />
                            </Border>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24,50" Spacing="8" HorizontalOptions="Center">
                        <Label Text="Hali sharhlar yo'q" FontSize="20" FontFamily="{StaticResource FontSFMedium}" TextColor="#22292F" HorizontalTextAlignment="Center" />
                        <Label Text="Bu mahsulot bo'yicha birinchi sharhni xaridorlar qoldirishi mumkin." FontSize="15" FontFamily="{StaticResource FontSFRegular}" TextColor="#96979B" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
            </RefreshView>
                        
            <!-- Review eligibility / write review -->
            <Border
                Grid.Row="4"
                Margin="12,6,12,12"
                Padding="12"
                BackgroundColor="#F7F8FB"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 10">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                    <Label
                        Text="{Binding ReviewEligibilityText}"
                        TextColor="#62666D"
                        FontSize="14"
                        FontFamily="{StaticResource FontSFRegular}"
                        LineBreakMode="WordWrap" />
                    <Button
                        Grid.Row="1"
                        Text="{Binding ReviewActionText}"
                        HeightRequest="52"
                        CornerRadius="8"
                        BackgroundColor="#7CB518"
                        TextColor="White"
                        FontSize="18"
                        FontFamily="{StaticResource FontSFMedium}"
                        Command="{Binding WriteReviewCommand}"
                        IsVisible="{Binding CanShowReviewAction}" />
                </Grid>
            </Border>

        </Grid>
        <components:ImagePreviewView 
            x:Name="ImagePreview"/>
        <local:ProductReviewsFilterBottomSheet 
            x:Name="ProductReviewsFilterBottomSheetView"
            BindingContext="{Binding}"
            ZIndex="99" />
        <components:LoadingView
            x:Name="loading"
            ZIndex="1000"
            ShowLoading="{Binding IsLoading}" />
    </Grid>

</page:BasePage>