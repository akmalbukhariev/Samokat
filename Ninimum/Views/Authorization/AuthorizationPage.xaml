<?xml version="1.0" encoding="utf-8" ?>
<page:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:language="clr-namespace:Ninimum.Resources.Languages"
    xmlns:page="clr-namespace:Ninimum.Views"
    xmlns:components="clr-namespace:Ninimum.Components"
    x:Class="Ninimum.Views.Authorization.AuthorizationPage"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="White"
    x:Name="RootPage">

    <Grid>
        <ScrollView>
            <VerticalStackLayout
                Padding="20,20,30,50"
                Spacing="24">

                <!-- Header -->
                <components:PageHeaderView
                    Title="{x:Static language:AppResource.Authorization}"/>

                <!-- Description -->
                <Label
                    Text="{x:Static language:AppResource.PleaseEnterYourPhoneNumber}"
                    HorizontalTextAlignment="Center"
                    TextColor="#96979B"
                    FontSize="17"
                    FontFamily="{StaticResource FontSFRegular}"
                    CharacterSpacing="0.17" />

                <!-- Input -->
                <components:InputView
                    Title="{x:Static language:AppResource.PhoneNumber}"
                    LeftIcon="ic_phone.png"
                    Keyboard="Telephone"
                    Text="{Binding PhoneNumber}" 
                    ClearButtonVisibility="WhileEditing"/>

                <!-- Button -->
                <components:CustomActionButton
                        x:Name="btnSend"
                        ButtonText="{x:Static language:AppResource.Send}"
                        ButtonBackgroundColor="#FD473C"
                        ButtonTextColor="White"
                        ButtonImageSource="right.png"
                        TapCommand="{Binding SendCommand}"/>

                <!-- Footer -->
                <Label
                    Text="{x:Static language:AppResource.YouCanUseThePlatformWithThisPhone}"
                    HorizontalTextAlignment="Center"
                    TextColor="#96979B"
                    FontSize="17"
                    FontFamily="{StaticResource FontSFRegular}"
                    CharacterSpacing="0.17" />

            </VerticalStackLayout>
        </ScrollView>
    
        <components:SmsCodePopup
                x:Name="popupSms"
                ConfirmCommand="{Binding Source={x:Reference RootPage}, Path=BindingContext.ConfirmSmsCodeCommand}"
                ResendCommand="{Binding Source={x:Reference RootPage}, Path=BindingContext.ResendSmsCommand}"
                IsVisible="False"/>
        
        <components:LoadingView 
            x:Name="loading"
            ShowLoading="{Binding IsLoading}"/>
    </Grid>
</page:BasePage>
