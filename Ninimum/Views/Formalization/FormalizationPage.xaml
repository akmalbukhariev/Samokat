<?xml version="1.0" encoding="utf-8" ?>
<page:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:language="clr-namespace:Ninimum.Resources.Languages"
    xmlns:page="clr-namespace:Ninimum.Views"
    xmlns:components="clr-namespace:Ninimum.Components"
    x:Class="Ninimum.Views.Formalization.FormalizationPage"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    x:Name="ThisPage"
    BackgroundColor="White">

    <Grid RowDefinitions="Auto,20,*,Auto,8">

        <components:PageHeaderView Title="{x:Static language:AppResource.Checkout}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,0,16,30" Spacing="24">

                <!-- Address -->
                <Label
                    Text="{x:Static language:AppResource.DeliveryAddress}"
                    FontSize="22"
                    TextColor="#22292F"
                    FontFamily="{StaticResource FontSFMedium}" />

                <Border
                    Stroke="#E7E7E7"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16"
                    BackgroundColor="White">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnChangeAddressTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Image
                            Source="ic_location.png"
                            WidthRequest="28"
                            HeightRequest="28"
                            VerticalOptions="Center" />

                        <Label
                            x:Name="AddressLabel"
                            Grid.Column="1"
                            Text="{x:Static language:AppResource.SampleDeliveryAddress}"
                            FontSize="17"
                            TextColor="#22292F"
                            FontFamily="{StaticResource FontSFRegular}"
                            LineBreakMode="WordWrap" />

                        <Image
                            Grid.Column="2"
                            Source="ic_arrow_right.png"
                            WidthRequest="20"
                            HeightRequest="20"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Products -->
                <Label
                    Text="{x:Static language:AppResource.Products}"
                    FontSize="22"
                    TextColor="#22292F"
                    FontFamily="{StaticResource FontSFMedium}" />

                <Border
                    Stroke="#E7E7E7"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16"
                    BackgroundColor="White">

                    <VerticalStackLayout Spacing="14">

                        <CollectionView
                            ItemsSource="{Binding Products}"
                            SelectionMode="None"
                            HeightRequest="90">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        WidthRequest="80"
                                        HeightRequest="80"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="#F7F8FB">

                                        <Grid>
                                            <Image
                                                Source="{Binding ImageSource}"
                                                Aspect="AspectFit"
                                                WidthRequest="70"
                                                HeightRequest="70"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />

                                            <Border
                                                BackgroundColor="#88000000"
                                                WidthRequest="28"
                                                HeightRequest="28"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 2"
                                                HorizontalOptions="End"
                                                VerticalOptions="End">

                                                <Label
                                                    Text="{Binding Quantity}"
                                                    TextColor="White"
                                                    FontSize="18"
                                                    FontFamily="{StaticResource FontSFMedium}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <HorizontalStackLayout
                            HorizontalOptions="Center"
                            Spacing="6">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToggleProductsTapped" />
                            </HorizontalStackLayout.GestureRecognizers>

                            <Label
                                x:Name="ProductsToggleLabel"
                                Text="{x:Static language:AppResource.View2Products}"
                                FontSize="17"
                                TextColor="#22292F"
                                FontFamily="{StaticResource FontSFMedium}" />

                            <Image
                                x:Name="ProductsToggleIcon"
                                Source="ic_arrow_down.png"
                                WidthRequest="18"
                                HeightRequest="18"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <CollectionView
                            x:Name="ProductDetailsCollectionView"
                            ItemsSource="{Binding Products}"
                            SelectionMode="None"
                            IsVisible="False"
                            HeightRequest="0">

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        ColumnDefinitions="70,*"
                                        ColumnSpacing="12"
                                        Padding="0,10">

                                        <Image
                                            Source="{Binding ImageSource}"
                                            WidthRequest="60"
                                            HeightRequest="60"
                                            Aspect="AspectFit" />

                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Label
                                                Text="{Binding Name}"
                                                FontSize="16"
                                                TextColor="#22292F"
                                                FontFamily="{StaticResource FontSFRegular}"
                                                LineBreakMode="WordWrap" />

                                            <Label
                                                Text="{Binding DetailText}"
                                                FontSize="15"
                                                TextColor="#96979B"
                                                FontFamily="{StaticResource FontSFRegular}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border> 

                <!-- Payment -->
                <Label
                    IsVisible="False"
                    Text="{x:Static language:AppResource.PaymentMethod}"
                    FontSize="22"
                    TextColor="#22292F"
                    FontFamily="{StaticResource FontSFMedium}" />

                <Border
                    IsVisible="False"
                    Stroke="#7CB518"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16"
                    BackgroundColor="White">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPaymentMethodTapped" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14">

                        <Image
                            Source="card_check_radibutton.png"
                            WidthRequest="25"
                            HeightRequest="25"
                            VerticalOptions="Center" />

                        <Border
                            Grid.Column="1"
                            WidthRequest="48"
                            HeightRequest="48"
                            BackgroundColor="#F7F8FB"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10">
                            <Image
                                Source="ic_payment_card.png"
                                WidthRequest="26"
                                HeightRequest="26"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="2" Spacing="3">
                            <Label
                                Text="{x:Static language:AppResource.ByCard}"
                                FontSize="17"
                                TextColor="#22292F"
                                FontFamily="{StaticResource FontSFMedium}" />

                            <Label
                                x:Name="PaymentCardLabel"
                                Text="UZCARD, HUMO, Visa"
                                FontSize="15"
                                TextColor="#96979B"
                                FontFamily="{StaticResource FontSFRegular}" />
                        </VerticalStackLayout>

                        <Image
                            Grid.Column="3"
                            x:Name="imCard"
                            Source="ic_arrow_right.png"
                            WidthRequest="20"
                            HeightRequest="20"
                            VerticalOptions="Center" />
                        <ActivityIndicator 
                            Grid.Column="3"
                            x:Name="loadingCard"
                            IsVisible="False"
                            Color="{StaticResource PrimaryColor}"
                            Scale="1"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Summary -->
                <Label
                    Text="{x:Static language:AppResource.OrderDetails}"
                    FontSize="22"
                    TextColor="#22292F"
                    FontFamily="{StaticResource FontSFMedium}" />

                <Border
                    Stroke="#E7E7E7"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16"
                    BackgroundColor="White">

                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="{x:Static language:AppResource.NumberOfProducts}"
                                FontSize="16"
                                TextColor="#22292F"
                                FontFamily="{StaticResource FontSFRegular}" />
                            <Label
                                x:Name="ProductsCountLabel"
                                Grid.Column="1"
                                FontSize="16"
                                TextColor="#22292F"
                                FontFamily="{StaticResource FontSFMedium}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="{x:Static language:AppResource.ProductsTotal}"
                                FontSize="16"
                                TextColor="#22292F"
                                FontFamily="{StaticResource FontSFRegular}" />
                            <Label
                                x:Name="ProductsPriceLabel"
                                Grid.Column="1"
                                FontSize="16"
                                TextColor="#22292F"
                                FontFamily="{StaticResource FontSFMedium}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="{x:Static language:AppResource.Delivery}"
                                FontSize="16"
                                TextColor="#22292F"
                                FontFamily="{StaticResource FontSFRegular}" />
                            <Label
                                x:Name="DeliveryPriceLabel"
                                Grid.Column="1"
                                FontSize="16"
                                TextColor="#7CB518"
                                FontFamily="{StaticResource FontSFMedium}" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#E7E7E7" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                Text="{x:Static language:AppResource.TotalPayment}"
                                FontSize="17"
                                TextColor="#22292F"
                                FontFamily="{StaticResource FontSFRegular}" />
                            <Label
                                x:Name="TotalPriceLabel"
                                Grid.Column="1"
                                FontSize="22"
                                TextColor="#22292F"
                                FontFamily="{StaticResource FontSFMedium}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label
                    Text="{x:Static language:AppResource.YourDataIsProtected}"
                    HorizontalTextAlignment="Center"
                    FontSize="14"
                    TextColor="#96979B"
                    FontFamily="{StaticResource FontSFRegular}" />

            </VerticalStackLayout>
        </ScrollView>

        <Button
            Grid.Row="3"
            Text="{x:Static language:AppResource.PlaceOrder}"
            FontFamily="{StaticResource FontSFMedium}"
            FontSize="18"
            CornerRadius="8"
            HeightRequest="56"
            Margin="16,0,16,0"
            TextColor="White"
            BackgroundColor="#FD473C"
            Clicked="OnCreateOrderClicked" />
        
        <components:LoadingView
            Grid.RowSpan="5"
            x:Name="loading"
            ShowLoading="{Binding IsLoading}"/>
     
    </Grid>
</page:BasePage>
