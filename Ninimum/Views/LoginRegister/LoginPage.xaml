<?xml version="1.0" encoding="utf-8" ?>
<page:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:language="clr-namespace:Ninimum.Resources.Languages"
    xmlns:page="clr-namespace:Ninimum.Views"
    xmlns:components="clr-namespace:Ninimum.Components"
    x:Class="Ninimum.Views.LoginRegister.LoginPage"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="White"
    x:Name="RootPage">
    
    <Grid>

        <!-- Main scrollable content -->
        <ScrollView>
            <VerticalStackLayout
                Padding="30,70,30,40"
                Spacing="24">

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    Spacing="20">

                    <Image
                        Source="logo.png"
                        HeightRequest="130"
                        WidthRequest="130"
                        Aspect="AspectFit"
                        HorizontalOptions="Center" />

                    <Label HorizontalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Ninimum" TextColor="#FD473C" FontFamily="SansitaOne" FontSize="36" />
                                <Span Text="." TextColor="#22292F" FontFamily="SansitaOne" FontSize="36" />
                                <Span Text="uz" TextColor="#FD473C" FontFamily="SansitaOne" FontSize="36" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>

                <Label
                    Text="{x:Static language:AppResource.AllAppFeaturesAreAvailableOnlyToRegistered}"
                    HorizontalTextAlignment="Center"
                    TextColor="#96979B"
                    FontFamily="{StaticResource FontSFRegular}"
                    FontSize="15" />

                <VerticalStackLayout Spacing="14">
                    <components:InputView
                        Title="{x:Static language:AppResource.PhoneNumber}"
                        LeftIcon="ic_phone.png"
                        Keyboard="Telephone"
                        ClearButtonVisibility="WhileEditing"
                        Text="{Binding PhoneNumber}" />

                    <components:InputView
                        Placeholder="*****"
                        LeftIcon="ic_lock.png"
                        IsPassword="True"
                        EnablePasswordToggle="True"
                        PasswordHideIcon="ic_eye_off.png"
                        PasswordShowIcon="ic_eye_on.png"
                        Text="{Binding Password}" />
                </VerticalStackLayout>

                <Label
                    Text="{x:Static language:AppResource.ForgotYourPassword}"
                    TextColor="#FD473C"
                    FontFamily="{StaticResource FontSFRegular}"
                    
                    FontSize="17">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer
                            NumberOfTapsRequired="1"
                            Tapped="ForgotPassword_Tapped"/>
                    </Label.GestureRecognizers>
                </Label>

                <components:CustomActionButton
                    x:Name="btnLogin"
                    ButtonText="{x:Static language:AppResource.SignIn}"
                    ButtonBackgroundColor="#FD473C"
                    ButtonTextColor="White"
                    ButtonImageSource="right.png"
                    TapCommand="{Binding LoginCommand}" />

                <Label
                    Text="{x:Static language:AppResource.IfYouHaveNotRegisteredYet}"
                    HorizontalTextAlignment="Center"
                    TextColor="#96979B"
                    FontFamily="{StaticResource FontSFRegular}"
                    FontSize="17" />

                <components:CustomActionButton
                    x:Name="btnRegister"
                    ButtonText="{x:Static language:AppResource.Register}"
                    ButtonBackgroundColor="#7CB518"
                    ButtonTextColor="White"
                    TapCommand="{Binding RegisterCommand}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Popup must be OUTSIDE ScrollView -->
        <components:SmsCodePopup
                x:Name="popupSms"
                ConfirmCommand="{Binding BindingContext.ConfirmSmsCodeCommand, Source={x:Reference Name=RootPage}}"
                ResendCommand="{Binding BindingContext.ResendSmsCommand, Source={x:Reference Name=RootPage}}"
                IsVisible="False"/>
        
        <components:LoadingView 
            x:Name="loading"
            ShowLoading="{Binding IsLoading}"/>
    </Grid>
</page:BasePage>
