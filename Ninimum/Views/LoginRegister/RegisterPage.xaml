<?xml version="1.0" encoding="utf-8" ?>
<page:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:language="clr-namespace:Ninimum.Resources.Languages"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:sys="clr-namespace:System;assembly=netstandard"
    xmlns:page="clr-namespace:Ninimum.Views"
    xmlns:components="clr-namespace:Ninimum.Components"
    x:Class="Ninimum.Views.LoginRegister.RegisterPage"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="White">

    <Grid RowDefinitions="50, *">
        <components:PageHeaderView
                Title="{x:Static language:AppResource.Register}"/>
   
        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="20,10,30,50"
                Spacing="20">

                <Label
                    Text="{x:Static language:AppResource.ToUseAllFeaturesOfThisAppPlease}"
                    HorizontalTextAlignment="Center"
                    TextColor="#96979B"
                    FontSize="17"
                    FontFamily="{StaticResource FontSFRegular}"
                    CharacterSpacing="0.17" />

                <components:InputView
                    Title="{x:Static language:AppResource.FirstName_231ae8}"
                    LeftIcon="ic_user.png"
                    Text="{Binding FirstName}"
                    ClearButtonVisibility="WhileEditing" />

                <components:InputView
                    Title="{x:Static language:AppResource.LastName_f40b4b}"
                    LeftIcon="ic_user.png"
                    Text="{Binding LastName}"
                    ClearButtonVisibility="WhileEditing" />

                <components:InputView
                    Title="{x:Static language:AppResource.PhoneNumber}"
                    LeftIcon="ic_phone.png"
                    Keyboard="Telephone"
                    Text="{Binding PhoneNumber}"
                    ClearButtonVisibility="WhileEditing"
                    IsVisible="False"/>

                <components:InputView
                    Title="{x:Static language:AppResource.Address}"
                    LeftIcon="ic_location.png"
                    IsReadOnly="True"
                    Text="{Binding Address}"
                    TapCommand="{Binding AddressTapCommand}" />

                <components:InputView
                    Title="{x:Static language:AppResource.Password}"
                    LeftIcon="ic_lock.png"
                    IsPassword="True"
                    EnablePasswordToggle="True"
                    PasswordHideIcon="ic_eye_off.png"
                    PasswordShowIcon="ic_eye_on.png"
                    Text="{Binding Password}" />

                <components:InputView
                    Title="{x:Static language:AppResource.RepeatPassword_b7aca1}"
                    LeftIcon="ic_lock.png"
                    IsPassword="True"
                    EnablePasswordToggle="True"
                    PasswordHideIcon="ic_eye_off.png"
                    PasswordShowIcon="ic_eye_on.png"
                    Text="{Binding ConfirmPassword}" />

                <Label
                    Text="{x:Static language:AppResource.ChildrenInformationOptional}"
                    TextColor="#96979B"
                    FontSize="17"
                    FontFamily="{StaticResource FontSFMedium}"
                    CharacterSpacing="0.17"
                    IsVisible="False"
                    HorizontalOptions="Center" />
    
                <CollectionView 
                    ItemsSource="{Binding Children}"
                    IsVisible="False">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="20">

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="20" Padding="20,0">
                                    <components:CustomRadioButtonView
                                        Grid.Column="0"
                                        Text="{x:Static language:AppResource.Boy}"
                                        IsSelected="{Binding IsBoySelected}"
                                        Command="{Binding SelectGenderCommand}"
                                        CommandParameter="boy"
                                        SelectedColor="#21C940"
                                        UnselectedColor="#96979B"
                                        TextColor="#22292F"
                                        FontSize="17"
                                        FontFamily="{StaticResource FontSFRegular}" />

                                    <components:CustomRadioButtonView
                                        Grid.Column="1"
                                        Text="{x:Static language:AppResource.Girl}"
                                        IsSelected="{Binding IsGirlSelected}"
                                        Command="{Binding SelectGenderCommand}"
                                        CommandParameter="girl"
                                        SelectedColor="#21C940"
                                        UnselectedColor="#96979B"
                                        TextColor="#22292F"
                                        FontSize="17"
                                        FontFamily="{StaticResource FontSFRegular}" />
                                </Grid>

                                <components:InputView
                                    Title="{x:Static language:AppResource.FirstName}"
                                    LeftIcon="ic_user.png"
                                    Text="{Binding FirstName}"
                                    ClearButtonVisibility="WhileEditing" />

                                <components:InputView
                                    Title="{x:Static language:AppResource.LastName}"
                                    LeftIcon="ic_user.png"
                                    Text="{Binding LastName}"
                                    ClearButtonVisibility="WhileEditing" />

                                <Grid Margin="0,0,0,10">

                                    <components:InputView
                                        x:Name="birthInput"
                                        Title="{x:Static language:AppResource.DateOfBirth}"
                                        LeftIcon="ic_calendar.png"
                                        Text="{Binding BirthDate}"
                                        IsEnabled="False"/>

                                    <DatePicker
                                        Opacity="0.01"
                                        Date="{Binding SelectedBirthDate}"
                                        MaximumDate="{x:Static sys:DateTime.Today}"
                                        Format="yyyy-MM-dd"/>
                                </Grid>

                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button
                    Text="{x:Static language:AppResource.Add}"
                    TextColor="#FD473C"
                    BackgroundColor="#FFF2F3"
                    CornerRadius="20"
                    HeightRequest="36"
                    FontSize="15"
                    FontFamily="{StaticResource FontSFMedium}"
                    CharacterSpacing="0.15"
                    IsVisible="False"
                    Command="{Binding AddChildCommand}" />

                <Grid
                    Padding="20,0,0,0"
                    ColumnDefinitions="30,*"
                    ColumnSpacing="12">

                    <Image
                        Grid.Column="0"
                        WidthRequest="24"
                        HeightRequest="24"
                        VerticalOptions="Center">

                        <Image.Triggers>
                            <DataTrigger
                                TargetType="Image"
                                Binding="{Binding IsAgreementChecked}"
                                Value="True">
                                <Setter Property="Source" Value="ic_check.png" />
                            </DataTrigger>

                            <DataTrigger
                                TargetType="Image"
                                Binding="{Binding IsAgreementChecked}"
                                Value="False">
                                <Setter Property="Source" Value="ic_uncheck.png" />
                            </DataTrigger>
                        </Image.Triggers>
                    </Image>

                    <Label
                        Grid.Column="1"
                        Text="{x:Static language:AppResource.IConfirmThatAllEnteredInformationIsCorrect}"
                        TextColor="#22292F"
                        FontSize="17"
                        FontFamily="{StaticResource FontSFRegular}"
                        CharacterSpacing="0.17"
                        VerticalTextAlignment="Center"
                        HorizontalOptions="Fill"
                        LineBreakMode="WordWrap" />

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleAgreementCommand}" />
                    </Grid.GestureRecognizers>
                </Grid>

                <components:CustomActionButton
                    x:Name="btnRegister"
                    ButtonText="{x:Static language:AppResource.Register}"
                    ButtonBackgroundColor="#FD473C"
                    ButtonTextColor="White"
                    ButtonImageSource="right.png"
                    TapCommand="{Binding RegisterCommand}" />

                <Label
                Text="{x:Static language:AppResource.EnteringAnotherPersonSInformationMayViolateThe}"
                HorizontalTextAlignment="Center"
                TextColor="#96979B"
                FontSize="17"
                FontFamily="{StaticResource FontSFRegular}"
                CharacterSpacing="0.17" />
            </VerticalStackLayout>
        </ScrollView>
        <components:LoadingView
            Grid.RowSpan="2"
            x:Name="loading"
            ShowLoading="{Binding IsLoading}"/>
    </Grid>
</page:BasePage>
