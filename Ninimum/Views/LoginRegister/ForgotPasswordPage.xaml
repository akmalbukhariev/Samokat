<?xml version="1.0" encoding="utf-8" ?>
<page:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:page="clr-namespace:Ninimum.Views"
    xmlns:components="clr-namespace:Ninimum.Components"
    x:Class="Ninimum.Views.LoginRegister.ForgotPasswordPage"
    BackgroundColor="White">

    <Grid>
        <ScrollView>
            <VerticalStackLayout
                Padding="20,20,30,50"
                Spacing="24">

                <components:PageHeaderView
                    Title="Parolni tiklash" />

                <Label
                    Text="Ro'yxatdan o'tgan telefon raqamingizga yangi vaqtinchalik parol SMS orqali yuboriladi."
                    HorizontalTextAlignment="Center"
                    TextColor="#96979B"
                    FontSize="17"
                    FontFamily="{StaticResource FontSFRegular}"
                    CharacterSpacing="0.17" />

                <components:InputView
                    Title="Telefon raqam"
                    LeftIcon="ic_phone.png"
                    Keyboard="Telephone"
                    Text="{Binding PhoneNumber}"
                    IsReadOnly="True"
                    ClearButtonVisibility="Never" />

                <components:CustomActionButton
                    x:Name="btnSend"
                    ButtonText="Vaqtinchalik parol yuborish"
                    ButtonBackgroundColor="#FD473C"
                    ButtonTextColor="White"
                    ButtonImageSource="right.png"
                    TapCommand="{Binding SendCommand}" />

                <Label
                    Text="SMS kelgach, kirish sahifasida shu telefon raqami va yuborilgan vaqtinchalik parol bilan kiring."
                    HorizontalTextAlignment="Center"
                    TextColor="#96979B"
                    FontSize="16"
                    FontFamily="{StaticResource FontSFRegular}"
                    CharacterSpacing="0.16" />

            </VerticalStackLayout>
        </ScrollView>

        <components:LoadingView
            ShowLoading="{Binding IsLoading}" />
    </Grid>
</page:BasePage>
