<?xml version="1.0" encoding="utf-8" ?>
<page:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:page="clr-namespace:Ninimum.Views"
    xmlns:components="clr-namespace:Ninimum.Components"
    x:Class="Ninimum.Views.ChangePhoneNumber.ChangePhoneNumberPage"
    x:Name="ThisPage"
    BackgroundColor="White">

    <Grid RowDefinitions="Auto,*,Auto">

        <components:PageHeaderView
            Grid.Row="0"
            Title="Telefon raqamini o‘zgartirish" />

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,24,20,24" Spacing="24">

                <VerticalStackLayout Spacing="4">
                    <Label
                        Text="Sizning amaldagi telefon raqamingiz"
                        FontFamily="{StaticResource FontSFRegular}"
                        FontSize="17"
                        TextColor="#96979B" />

                    <Label
                        Text="{Binding CurrentPhoneNumber}"
                        FontFamily="{StaticResource FontSFMedium}"
                        FontSize="17"
                        TextColor="#7CB518" />
                </VerticalStackLayout>

                <Label
                    Text="Yangi telefon raqamingizni kiriting. Yangi raqam SMS kod orqali tasdiqlanadi."
                    FontFamily="{StaticResource FontSFRegular}"
                    FontSize="17"
                    TextColor="#22292F"
                    LineBreakMode="WordWrap" />

                <Border
                    Padding="10"
                    BackgroundColor="#FFF2F3"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8">
                    <Label
                        Text="Diqqat! Tasdiqlash tugagach, xavfsizlik uchun akkauntga yangi raqam bilan qayta kirishingiz kerak."
                        FontFamily="{StaticResource FontSFRegular}"
                        FontSize="13"
                        TextColor="#EA1111" />
                </Border>

                <components:InputView
                    Title="Yangi telefon raqam"
                    Placeholder="90 123 45 67"
                    LeftIcon="ic_phone.png"
                    Keyboard="Telephone"
                    ClearButtonVisibility="WhileEditing"
                    Text="{Binding PhoneNumber}" />

                <Grid ColumnDefinitions="24,*" ColumnSpacing="12">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleAgreementCommand}" />
                    </Grid.GestureRecognizers>

                    <Image
                        Source="{Binding AgreementIcon}"
                        WidthRequest="24"
                        HeightRequest="24"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        Text="Kiritilgan telefon raqam menga tegishli ekanini tasdiqlayman"
                        FontFamily="{StaticResource FontSFRegular}"
                        FontSize="16"
                        TextColor="#22292F"
                        LineBreakMode="WordWrap" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <Button
            Grid.Row="2"
            Text="Davom etish"
            HeightRequest="56"
            CornerRadius="8"
            Margin="15,0,15,24"
            BackgroundColor="{Binding SubmitButtonColor}"
            TextColor="White"
            FontFamily="{StaticResource FontSFMedium}"
            FontSize="18"
            IsEnabled="{Binding CanSubmit}"
            Command="{Binding SubmitCommand}" />

        <components:SmsCodePopup
            x:Name="popupSms"
            Grid.RowSpan="3"
            ConfirmCommand="{Binding ConfirmSmsCodeCommand}"
            ResendCommand="{Binding ResendSmsCommand}"
            IsVisible="False"
            ZIndex="100" />

        <components:LoadingView
            Grid.RowSpan="3"
            ShowLoading="{Binding IsLoading}"
            ZIndex="110" />

    </Grid>
</page:BasePage>
