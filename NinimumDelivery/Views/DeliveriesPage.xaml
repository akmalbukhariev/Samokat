<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="NinimumDelivery.Views.DeliveriesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lang="clr-namespace:NinimumDelivery.Resources.Languages"
             xmlns:models="clr-namespace:NinimumDelivery.Models"
             xmlns:components="clr-namespace:NinimumDelivery.Components"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">
        <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsLoading}">
            <ScrollView>
                <VerticalStackLayout Padding="22,24,22,32" Spacing="18">
                    <Label Text="Ninimum Delivery" Style="{StaticResource PageTitle}" />
                    <Label Text="{Binding WorkerGreeting}" Style="{StaticResource MutedLabel}" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border Grid.Column="0" Padding="12" BackgroundColor="{StaticResource PrimarySoft}" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                            <VerticalStackLayout Spacing="5"><Label Text="{Binding Dashboard.availableCount}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}"/><Label Text="{x:Static lang:AppResource.Available}" FontSize="12" TextColor="{StaticResource MutedColor}"/></VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Padding="12" BackgroundColor="#FFF8E8" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                            <VerticalStackLayout Spacing="5"><Label Text="{Binding Dashboard.activeCount}" FontSize="24" FontAttributes="Bold" TextColor="#D98C00"/><Label Text="{x:Static lang:AppResource.Active}" FontSize="12" TextColor="{StaticResource MutedColor}"/></VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Padding="12" BackgroundColor="#EDF9F0" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                            <VerticalStackLayout Spacing="5"><Label Text="{Binding Dashboard.completedTodayCount}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource SuccessColor}"/><Label Text="{x:Static lang:AppResource.CompletedToday}" FontSize="12" TextColor="{StaticResource MutedColor}"/></VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Label Text="{x:Static lang:AppResource.AvailableOrders}" Style="{StaticResource SectionTitle}" VerticalTextAlignment="Center" />
                        <Label Grid.Column="1" Text="{Binding SelectedAvailableCount, StringFormat='Tanlandi: {0}'}" IsVisible="{Binding HasSelectedAvailableJobs}" TextColor="{StaticResource PrimaryColor}" FontAttributes="Bold" VerticalTextAlignment="Center" />
                    </Grid>
                    <Label Text="Bir safarda olib ketadigan buyurtmalaringizni belgilang." Style="{StaticResource MutedLabel}" />
                    <Label Text="{x:Static lang:AppResource.NoAvailableOrders}" IsVisible="{Binding AvailableJobs.Count, Converter={StaticResource ZeroToTrueConverter}}" Style="{StaticResource MutedLabel}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding AvailableJobs}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:DeliveryJob">
                                <Border Padding="16" Stroke="{StaticResource BorderColor}" BackgroundColor="White" StrokeShape="RoundRectangle 18">
                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="10" ColumnSpacing="12">
                                        <CheckBox Grid.RowSpan="3" IsChecked="{Binding IsSelected}" VerticalOptions="Start" Color="{StaticResource PrimaryColor}" />
                                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="3">
                                            <Label Text="{Binding DisplayOrderNumber}" FontSize="18" FontAttributes="Bold" />
                                            <Label Text="{Binding deliveryAddress}" Style="{StaticResource MutedLabel}" MaxLines="2" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <Border Grid.Row="0" Grid.Column="2" Padding="10,5" BackgroundColor="{StaticResource PrimarySoft}" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                                            <Label Text="{Binding StatusText}" FontSize="12" TextColor="{StaticResource PrimaryColor}" FontAttributes="Bold" />
                                        </Border>
                                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding ProductCountText}" Style="{StaticResource MutedLabel}" />
                                            <Label Grid.Column="1" Text="{Binding PriceText}" FontAttributes="Bold" />
                                        </Grid>
                                        <Button Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Static lang:AppResource.View}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCommand}" CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Button Text="Tanlangan buyurtmalarni olish" Command="{Binding ClaimSelectedCommand}" IsVisible="{Binding HasSelectedAvailableJobs}" Style="{StaticResource PrimaryButton}" />

                    <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                        <Label Text="{x:Static lang:AppResource.MyDeliveries}" Style="{StaticResource SectionTitle}" VerticalTextAlignment="Center" />
                        <Button Grid.Column="1" Text="Xaritada yo‘l" Command="{Binding OpenRouteMapCommand}" IsVisible="{Binding HasMultipleActiveJobs}" Style="{StaticResource SecondaryButton}" Padding="12,7" />
                    </Grid>
                    <Border Padding="14" BackgroundColor="#FFF8E8" StrokeThickness="0" StrokeShape="RoundRectangle 14" IsVisible="{Binding HasMultipleActiveJobs}">
                        <Label Text="Raqamlar tavsiya etilgan yetkazish tartibini ko‘rsatadi. 1-buyurtmadan boshlang." TextColor="#8A5A00" FontSize="13" />
                    </Border>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ActiveJobs}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:DeliveryJob">
                                <Border Padding="16" Stroke="{StaticResource BorderColor}" BackgroundColor="White" StrokeShape="RoundRectangle 18">
                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="10" ColumnSpacing="12">
                                        <Border Grid.RowSpan="2" WidthRequest="38" HeightRequest="38" BackgroundColor="{StaticResource PrimaryColor}" StrokeThickness="0" StrokeShape="RoundRectangle 19" IsVisible="{Binding HasRouteOrder}" VerticalOptions="Start">
                                            <Label Text="{Binding RouteOrderText}" TextColor="White" FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding DisplayOrderNumber}" FontSize="18" FontAttributes="Bold" />
                                        <Label Grid.Column="2" Text="{Binding StatusText}" TextColor="{StaticResource PrimaryColor}" FontAttributes="Bold" />
                                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="3">
                                            <Label Text="{Binding deliveryAddress}" Style="{StaticResource MutedLabel}" MaxLines="2" />
                                            <Label Text="{Binding RouteDistanceText}" TextColor="#D98C00" FontSize="12" FontAttributes="Bold" />
                                        </VerticalStackLayout>
                                        <Button Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Static lang:AppResource.View}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCommand}" CommandParameter="{Binding .}" Style="{StaticResource PrimaryButton}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Button Text="Yetkazish yo‘lini boshlash" Command="{Binding StartRouteCommand}" IsVisible="{Binding HasAcceptedJobs}" Style="{StaticResource PrimaryButton}" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <components:LoadingView IsLoading="{Binding IsLoading}" />
        <BoxView HeightRequest="1" BackgroundColor="LightGray" HorizontalOptions="Fill" Grid.Row="1"/>
    </Grid>
</ContentPage>
