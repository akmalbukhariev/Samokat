<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="NinimumDelivery.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lang="clr-namespace:NinimumDelivery.Resources.Languages"
             xmlns:models="clr-namespace:NinimumDelivery.Models"
             xmlns:components="clr-namespace:NinimumDelivery.Components"
             Shell.NavBarIsVisible="False">

    <Grid
        RowDefinitions="*,Auto">
        <Grid Padding="22,24,22,16">
            <Grid RowDefinitions="Auto,*" RowSpacing="18">
                <Label Text="{x:Static lang:AppResource.History}" Style="{StaticResource PageTitle}" />
                <RefreshView Grid.Row="1" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsLoading}">
                    <CollectionView ItemsSource="{Binding Jobs}" SelectionMode="None">
                        <CollectionView.EmptyView><Label Text="{x:Static lang:AppResource.NoHistory}" Style="{StaticResource MutedLabel}" HorizontalOptions="Center" Margin="0,50"/></CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:DeliveryJob">
                                <Border Margin="0,0,0,12" Padding="16" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 18">
                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8">
                                        <Label Text="{Binding DisplayOrderNumber}" FontAttributes="Bold" FontSize="18" />
                                        <Label Grid.Column="1" Text="{Binding StatusText}" TextColor="{StaticResource SuccessColor}" FontAttributes="Bold" />
                                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding deliveryAddress}" Style="{StaticResource MutedLabel}" MaxLines="2" />
                                        <Button Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Static lang:AppResource.View}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenCommand}" CommandParameter="{Binding .}" Style="{StaticResource SecondaryButton}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
            </Grid>
            <components:LoadingView IsLoading="{Binding IsLoading}" />
        </Grid>
        <BoxView
            HeightRequest="1"
            BackgroundColor="LightGray"
            HorizontalOptions="Fill"
            Grid.Row="1"/>
    </Grid>
</ContentPage>
