<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="NinimumDelivery.Views.LoginPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lang="clr-namespace:NinimumDelivery.Resources.Languages"
             xmlns:components="clr-namespace:NinimumDelivery.Components"
             Shell.NavBarIsVisible="False">
    <Grid Padding="28" RowDefinitions="*,Auto,*">
        <VerticalStackLayout Grid.Row="1" Spacing="18" MaximumWidthRequest="520">
            <Border WidthRequest="88" HeightRequest="88" BackgroundColor="{StaticResource PrimarySoft}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 24" HorizontalOptions="Center">
                <Label Text="N" FontSize="44" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            </Border>
            <Label Text="Ninimum Delivery" FontSize="30" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource TextColor}" />
            <Label Text="{x:Static lang:AppResource.LoginSubtitle}" Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />

            <Border Margin="0,10,0,0" Padding="14,5" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 14">
                <Entry Placeholder="{x:Static lang:AppResource.WorkerId}" Keyboard="Text" Text="{Binding WorkerId}" ReturnType="Next" />
            </Border>
            <Border Padding="14,5" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 14">
                <Entry Placeholder="{x:Static lang:AppResource.Password}" IsPassword="True" Text="{Binding Password}" />
            </Border>
            <Button Text="{x:Static lang:AppResource.Login}" Command="{Binding LoginCommand}" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" />
        </VerticalStackLayout>
        <components:LoadingView Grid.RowSpan="3" IsLoading="{Binding IsLoading}" />
    </Grid>
</ContentPage>
