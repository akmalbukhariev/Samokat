<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="NinimumDelivery.Views.ProfilePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lang="clr-namespace:NinimumDelivery.Resources.Languages"
             xmlns:components="clr-namespace:NinimumDelivery.Components"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="22,24,22,36" Spacing="18">
                <Label Text="{x:Static lang:AppResource.Profile}" Style="{StaticResource PageTitle}" />
                <Border Padding="18" Stroke="{StaticResource BorderColor}" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding Worker.fullName}" FontSize="22" FontAttributes="Bold" />
                        <Label Text="{Binding Worker.workerId, StringFormat='ID: {0}'}" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" />
                        <Label Text="{Binding Worker.phoneNumber}" Style="{StaticResource MutedLabel}" />
                        <Label Text="{Binding Worker.vehicleNumber}" Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Border>
                <Border Padding="18" BackgroundColor="{StaticResource SurfaceColor}" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout><Label Text="{x:Static lang:AppResource.Availability}" FontAttributes="Bold"/><Label Text="{x:Static lang:AppResource.Online}" Style="{StaticResource MutedLabel}"/></VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding Worker.online, Mode=OneWay}" Toggled="OnlineSwitch_Toggled" OnColor="{StaticResource SuccessColor}" />
                    </Grid>
                </Border>
                <Label Text="{x:Static lang:AppResource.Language}" Style="{StaticResource SectionTitle}" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Button Text="O‘zbekcha" Command="{Binding SetLanguageCommand}" CommandParameter="uz" Style="{StaticResource SecondaryButton}" />
                    <Button Grid.Column="1" Text="Русский" Command="{Binding SetLanguageCommand}" CommandParameter="ru" Style="{StaticResource SecondaryButton}" />
                    <Button Grid.Column="2" Text="English" Command="{Binding SetLanguageCommand}" CommandParameter="en" Style="{StaticResource SecondaryButton}" />
                </Grid>
                <Button Text="{x:Static lang:AppResource.Logout}" Command="{Binding LogoutCommand}" Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" />
            </VerticalStackLayout>
        </ScrollView>
        <components:LoadingView 
            IsLoading="{Binding IsLoading}" />
        <BoxView
            HeightRequest="1"
            BackgroundColor="LightGray"
            HorizontalOptions="Fill"
            Grid.Row="1"/>
    </Grid>
</ContentPage>
