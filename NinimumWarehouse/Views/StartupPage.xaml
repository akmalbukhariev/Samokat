<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:lang="clr-namespace:NinimumWarehouse.Resources.Languages" x:Class="NinimumWarehouse.Views.StartupPage">
    <VerticalStackLayout Spacing="18" HorizontalOptions="Center" VerticalOptions="Center">
        <Image Source="warehouse_brand.png" WidthRequest="72" HeightRequest="72"/>
        <Label Text="{x:Static lang:AppResource.AppName}" Style="{StaticResource SectionTitle}"/>
        <ActivityIndicator IsRunning="True" Color="{StaticResource PrimaryColor}"/>
        <Label Text="{x:Static lang:AppResource.Loading}" Style="{StaticResource MutedLabel}"/>
    </VerticalStackLayout>
</ContentPage>
