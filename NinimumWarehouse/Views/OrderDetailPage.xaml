<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:lang="clr-namespace:NinimumWarehouse.Resources.Languages" xmlns:vm="clr-namespace:NinimumWarehouse.ViewModels" xmlns:components="clr-namespace:NinimumWarehouse.Components" x:Class="NinimumWarehouse.Views.OrderDetailPage" x:DataType="vm:OrderDetailViewModel" Shell.NavBarIsVisible="False" Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Padding="14,12,14,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <ImageButton Source="back.png" Style="{StaticResource IconButton}" Clicked="OnBackClicked" SemanticProperties.Description="{x:Static lang:AppResource.Back}"/>
            <Label Grid.Column="1" Text="{x:Static lang:AppResource.Order}" Style="{StaticResource SectionTitle}" VerticalTextAlignment="Center"/>
            <ImageButton Grid.Column="2" Source="refresh.png" Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsAvailable}" SemanticProperties.Description="{x:Static lang:AppResource.Refresh}"/>
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,4,24,24" Spacing="18" IsEnabled="{Binding IsAvailable}">
                <Border BackgroundColor="{StaticResource ErrorSoft}" StrokeThickness="0" Padding="14" StrokeShape="RoundRectangle 12" IsVisible="{Binding HasError}">
                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource ErrorColor}"/>
                </Border>
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasOrder}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{Binding Number}" FontSize="18" FontAttributes="Bold" LineBreakMode="WordWrap"/>
                        <Border Padding="10,6" StrokeThickness="0" StrokeShape="RoundRectangle 10" HorizontalOptions="Start" BackgroundColor="{Binding Status, Converter={StaticResource StatusColor}, ConverterParameter=background}">
                            <Label Text="{Binding StatusText}" Style="{StaticResource BadgeLabel}" TextColor="{Binding Status, Converter={StaticResource StatusColor}}"/>
                        </Border>
                        <Label Text="{Binding ProgressText}" Style="{StaticResource FieldLabel}"/>
                        <ProgressBar Progress="{Binding Progress}" ProgressColor="{StaticResource SuccessColor}" BackgroundColor="{StaticResource SurfaceColor}"/>
                    </VerticalStackLayout>
                </Border>
                <Border Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource WarningSoft}" IsVisible="{Binding Unavailable}">
                    <Label Text="{x:Static lang:AppResource.OrderUnavailable}" TextColor="{StaticResource WarningColor}"/>
                </Border>
                <Label Text="{x:Static lang:AppResource.OtherWorker}" Style="{StaticResource MutedLabel}" IsVisible="{Binding OtherWorker}"/>
                <Border Padding="16" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource WarningSoft}" IsVisible="{Binding HasNote}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static lang:AppResource.Problem}" FontAttributes="Bold" TextColor="{StaticResource WarningColor}"/>
                        <Label Text="{Binding Note}" TextColor="{StaticResource WarningColor}"/>
                        <Label Text="{x:Static lang:AppResource.ProblemHint}" Style="{StaticResource MutedLabel}"/>
                    </VerticalStackLayout>
                </Border>
                <Label Text="{x:Static lang:AppResource.ItemsTitle}" Style="{StaticResource SectionTitle}" IsVisible="{Binding HasOrder}"/>
                <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding Items}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:OrderItemViewModel">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="14">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border WidthRequest="72" HeightRequest="72" Padding="6" BackgroundColor="{StaticResource SurfaceColor}" StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Start">
                                            <components:ProductImage Source="{Binding Image}" SemanticProperties.Description="{Binding Name}"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold"/>
                                            <Label Text="{Binding CheckState}" Style="{StaticResource MutedLabel}"/>
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2" BackgroundColor="{StaticResource SurfaceColor}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="10,8" VerticalOptions="Start">
                                            <Label Text="{Binding ProgressText}" FontAttributes="Bold"/>
                                        </Border>
                                    </Grid>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{x:Static lang:AppResource.Barcode}" Style="{StaticResource MutedLabel}"/>
                                        <Label Text="{Binding Barcode}" FontSize="14" LineBreakMode="WordWrap"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="12" IsVisible="{Binding IsEditable}">
                                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}"/>
                                        <Grid ColumnDefinitions="*,100" ColumnSpacing="12">
                                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                                <Label Text="{x:Static lang:AppResource.CheckedQuantity}" Style="{StaticResource FieldLabel}"/>
                                                <Label Text="{x:Static lang:AppResource.QuantityHelp}" Style="{StaticResource MutedLabel}"/>
                                            </VerticalStackLayout>
                                            <Border Grid.Column="1" Style="{StaticResource InputBorder}" Padding="8,6" VerticalOptions="Center">
                                                <Entry Text="{Binding QuantityInput}" Keyboard="Numeric" HorizontalTextAlignment="Center" ReturnType="Done"/>
                                            </Border>
                                        </Grid>
                                        <VerticalStackLayout Spacing="10" IsVisible="{Binding HasBarcode}">
                                            <Button Text="{x:Static lang:AppResource.ScanToCheck}" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}"/>
                                            <Button Text="{x:Static lang:AppResource.EnterCodeInstead}" Command="{Binding ToggleCodeCommand}" Style="{StaticResource TextButton}"/>
                                            <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowCodeInput}">
                                                <Border Style="{StaticResource InputBorder}">
                                                    <Entry Text="{Binding BarcodeInput}" Placeholder="{x:Static lang:AppResource.BarcodePlaceholder}" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" ReturnType="Go" ReturnCommand="{Binding ConfirmCommand}"/>
                                                </Border>
                                                <Button Text="{x:Static lang:AppResource.ConfirmCode}" Command="{Binding ConfirmCommand}" Style="{StaticResource SecondaryButton}"/>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Spacing="10" IsVisible="{Binding NoBarcode}">
                                            <Label Text="{x:Static lang:AppResource.ManualCheckHint}" Style="{StaticResource MutedLabel}"/>
                                            <Label Text="{x:Static lang:AppResource.Reason}" Style="{StaticResource FieldLabel}"/>
                                            <Border Style="{StaticResource InputBorder}">
                                                <Editor Text="{Binding Reason}" Placeholder="{x:Static lang:AppResource.ReasonPlaceholder}" MinimumHeightRequest="84" MaxLength="500"/>
                                            </Border>
                                            <Button Text="{x:Static lang:AppResource.ConfirmManually}" Command="{Binding ConfirmCommand}" Style="{StaticResource SecondaryButton}"/>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Border Padding="18" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="{StaticResource SuccessSoft}" IsVisible="{Binding IsReady}">
                    <Label Text="{x:Static lang:AppResource.ReadyMessage}" TextColor="{StaticResource SuccessColor}" FontAttributes="Bold"/>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <Border Grid.Row="2" Padding="24,14,24,20" Stroke="{StaticResource BorderColor}" BackgroundColor="White" IsVisible="{Binding ShowActions}">
            <VerticalStackLayout Spacing="8" IsEnabled="{Binding IsAvailable}">
                <Button Text="{x:Static lang:AppResource.StartPreparing}" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" IsVisible="{Binding CanStart}"/>
                <VerticalStackLayout Spacing="8" IsVisible="{Binding CanCheck}">
                    <Label Text="{x:Static lang:AppResource.PackingHint}" Style="{StaticResource MutedLabel}"/>
                    <Button Text="{x:Static lang:AppResource.PackedReady}" Command="{Binding ReadyCommand}" Style="{StaticResource PrimaryButton}"/>
                    <Button Text="{x:Static lang:AppResource.ReportProblem}" Command="{Binding ProblemCommand}" Style="{StaticResource TextButton}"/>
                </VerticalStackLayout>
                <Button Text="{x:Static lang:AppResource.Resume}" Command="{Binding ResumeCommand}" Style="{StaticResource PrimaryButton}" IsVisible="{Binding CanResume}"/>
            </VerticalStackLayout>
        </Border>
        <components:LoadingView Grid.RowSpan="3" IsLoading="{Binding IsBusy}"/>
    </Grid>
</ContentPage>
